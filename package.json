{
  "name": "oura-ts",
  "version": "0.0.0",
  "description": "TypeScript library and CLI for the Oura Ring API v2",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "oura": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "generate:types": "openapi-typescript openapi.json -o src/generated/types.ts",
    "prebuild": "pnpm run generate:types",
    "test": "vitest",
    "prepare": "husky",
    "release": "release-it"
  },
  "keywords": [
    "oura",
    "oura-ring",
    "api",
    "health",
    "sleep",
    "fitness"
  ],
  "author": "Maximilian Krause",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ky": "^1.14.3",
    "open": "^10.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@eslint/js": "^9.39.2",
    "@release-it/conventional-changelog": "^10.0.4",
    "@types/node": "^24.10.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "msw": "^2.12.7",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
